#!/usr/bin/env bash
# The one Wrangler every deploy and test script calls. It is pinned to an exact version in
# deploy/tools/package.json and deploy/tools/package-lock.json, and run from that
# directory's node_modules/.bin. A bare npx call is not used: it runs whatever is installed
# globally or fetches the latest, with the Cloudflare token in its environment.
# To change the version, edit deploy/tools/package.json, run `npm install` there, commit both files.
set -euo pipefail
TOOLS=$(cd "$(dirname "${BASH_SOURCE[0]}")/tools" && pwd)
BIN="$TOOLS/node_modules/.bin/wrangler"
[ -x "$BIN" ] || (cd "$TOOLS" && npm ci --silent >&2)
# #1410: a deploy of a config with Workers Logs on resets their query-string redaction to false (the
# pinned wrangler has no config key for it), and a store's query strings hold order keys and logins.
# So after every successful deploy, re-apply it and read it back, or turn the logs off and fail
# loudly (obs_settings.py after-deploy). This is the one wrangler every path calls, a hand-run one too.
# A --dry-run uploads nothing, so it needs no re-apply. A copy of this file without wfp/obs_settings.py next to it
# (a mirror or a test root) cannot re-apply, so a real deploy through it fails loudly rather than passing.
if [ "${1:-}" = deploy ]; then
  rc=0; "$BIN" "$@" || rc=$?
  [ "$rc" = 0 ] || exit "$rc"
  shift
  case " $* " in *" --dry-run "*) exit 0 ;; esac
  OBS="$(dirname "${BASH_SOURCE[0]}")/wfp/obs_settings.py"
  [ -f "$OBS" ] || { echo "deploy/wr: the deploy ran, but $OBS is missing, so this cannot re-apply the Workers Logs query-string redaction (#1410). If the config turns logs on, run obs_settings.py redact-or-off for the script NOW." >&2; exit 3; }
  python3 -I "$OBS" after-deploy "$@"
  exit $?
fi
exec "$BIN" "$@"
