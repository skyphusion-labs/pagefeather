# woocap: the b-dosql WooCommerce reliability and load site (docs/load-152.md). Read from the live Worker 2026-11-12.
VARIANT=b-dosql
LOCATION=enam
MEDIA=1
MEDIA_BUCKET=woocap-media
SITE_ORIGIN=https://woocap.skyphusion.workers.dev
HTTP_ALLOW_HOSTS=.wordpress.org,.woocommerce.com,.gravatar.com
# WooCommerce is active on this store, so its OPcache is built with WooCommerce primed (#373).
WOO_ACTIVE=1
