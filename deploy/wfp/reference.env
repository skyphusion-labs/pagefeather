# The Skyphusion reference deploy of deploy/wfp. Source it before running the
# deploy/wfp tools against the reference account:
#   . deploy/wfp/reference.env
# A self-hosted deploy does NOT source this file. It sets ACCOUNT_ID (and, for
# phase B Custom Domains, WFP_ZONE_ID and WFP_SUBDOMAIN) to its own values.
# These are ids, not credentials: the API token stays in CLOUDFLARE_API_TOKEN.
ACCOUNT_ID=fabcb25d9c7eb087110ec474a03e50d2   # Skyphusion Labs (Workers Paid, WfP on)
WFP_ZONE_ID=3b58b52bd324332fb56b3ab685588c76  # skyphusion.org, the phase B test zone
WFP_SUBDOMAIN=wfp-test.skyphusion.org
export ACCOUNT_ID WFP_ZONE_ID WFP_SUBDOMAIN
