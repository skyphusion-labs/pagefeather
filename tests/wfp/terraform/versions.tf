terraform {
  required_version = ">= 1.5.0"

  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5.28"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

# Paid account (Skyphusion Labs): CLOUDFLARE_API_TOKEN from the environment.
provider "cloudflare" {}
