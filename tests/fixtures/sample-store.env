# The WooCommerce sample store fixture (Conrad's rule: every WordPress test loads it).
# A mysqldump --single-transaction --hex-blob of the Azure bench database `wordpress` on
# wpref-mysql, taken by the lead on 2026-11-12 (firewall window 03:29Z to 03:31Z, fleet-chezmoi#2566).
# Generated sample data (the catalog was made through the WooCommerce REST batch endpoint, docs/results.md).
# It holds ONE real credential-shaped row: the admin (an email and a password hash). So the
# bucket is private, and load-sample-store.sh replaces the admin password on every load.
SAMPLE_STORE_SHA256=e84daed3e6865fa92c43d90dbb00da0c6e506d51faf0a23386aa20ebf477868c
SAMPLE_STORE_BYTES=647030
SAMPLE_STORE_BUCKET=wp-test-fixtures
SAMPLE_STORE_KEY=sample-store/20261112-e84daed3e686.sql.gz
# What a load must show (read back by load-sample-store.sh).
SAMPLE_STORE_PRODUCTS=2609
SAMPLE_STORE_ORDERS=900
SAMPLE_STORE_USERS=1
