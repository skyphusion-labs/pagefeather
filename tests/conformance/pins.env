# The upstream test suites of #759, pinned to the versions our sites run.
# spikes/b2-wordpress/build.sh pins WordPress 7.1.4 and WooCommerce 11.2.1.
# A full commit sha, never a tag: git checks every object against it, so the content is pinned.
# Gutenberg: the sha that wordpress-develop 7.1.4 names in package.json ("gutenberg.sha"),
# which is the editor that WordPress 7.1.4 bundles (23.6.0-rc.1).
WP_DEVELOP_REPO=https://github.com/WordPress/wordpress-develop.git
WP_DEVELOP_SHA=0afb74de8c3fe4c1869e44b62b0418d67b11aa4c
WC_REPO=https://github.com/woocommerce/woocommerce.git
WC_SHA=67e007c3c4cca5725e056ddaaa2ed2fb0e282045
GB_REPO=https://github.com/WordPress/gutenberg.git
GB_SHA=8daba429215ef3dce75da4360156b1a2f39897c6
