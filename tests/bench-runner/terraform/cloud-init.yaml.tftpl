#cloud-config
# bench-runner: pulls benchmark jobs from R2 and writes results back. No
# inbound: the Vultr firewall group has only a sentinel rule, and SSH is off.
# The runner scripts come from tests/bench-runner/box (base64, so this
# template does not interpolate them). The repository gives bench.py, e2e.sh
# and summarize.py, at the branch the job names.
package_update: true
packages: [python3, git, curl, ca-certificates]
users:
  - default
  - name: bench
    system: true
    shell: /usr/sbin/nologin
    homedir: /var/lib/bench
write_files:
  - path: /etc/bench-runner/env
    permissions: "0600"
    owner: root:root
    content: |
      R2_ENDPOINT=${r2_endpoint}
      R2_BUCKET=${r2_bucket}
      R2_KEY_ID=${r2_key_id}
      R2_SECRET=${r2_secret}
      REPO_DIR=/var/lib/bench/repo
      BRANCH=${branch}
      RUNNER_REGION=${region}
      RUNNER_PLAN=${plan}
  - path: /usr/local/bin/bench-runner
    permissions: "0755"
    encoding: b64
    content: ${runner_sh}
  - path: /usr/local/lib/bench-runner/runjob.py
    permissions: "0644"
    encoding: b64
    content: ${runjob_py}
  - path: /etc/systemd/system/bench-runner.service
    permissions: "0644"
    encoding: b64
    content: ${unit}
runcmd:
  # Nothing comes in: stop SSH too (the Vultr web console still works).
  - systemctl disable --now ssh.socket ssh.service || true
  - install -d -o bench -g bench -m 0750 /var/lib/bench
  - sudo -u bench git clone --branch ${branch} ${repo} /var/lib/bench/repo
  - systemctl daemon-reload
  - systemctl enable --now bench-runner.service
