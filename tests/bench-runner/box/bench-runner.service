[Unit]
Description=wordpress-on-cloudflare benchmark runner (jobs from R2)
Wants=network-online.target
After=network-online.target

[Service]
User=bench
Group=bench
# Read by systemd as root (mode 600); the runner sees the values as environment.
EnvironmentFile=/etc/bench-runner/env
ExecStart=/usr/local/bin/bench-runner
Restart=always
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bench

[Install]
WantedBy=multi-user.target
