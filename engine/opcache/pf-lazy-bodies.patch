+static bool pf_lb_pread(int fd, char *dst, size_t n, size_t off)
+{
+	if (!n) {
+		return true;
+	}
+	if (lseek(fd, (off_t)off, SEEK_SET) != (off_t)off) {
+		return false;
+	}
+	while (n) {
