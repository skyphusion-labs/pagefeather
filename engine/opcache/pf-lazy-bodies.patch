+static bool pf_lb_read(int fd, char *mem, const zend_file_cache_metainfo *info, bool lazy)
+{
+	if (!lazy) {
+		return pf_lb_pread(fd, mem, pf_lb_read_size(info, false), sizeof(*info));
+	}
+	return pf_lb_pread(fd, mem, info->pf_body_offset, sizeof(*info))
+		&& pf_lb_pread(fd, mem + info->pf_body_offset, info->str_size, sizeof(*info) + (size_t)info->mem_size);
+}
+
+static void *pf_lb_arena(size_t size)
+{
+#if defined(__AVX__) || defined(__SSE2__)
+	void *mem = zend_arena_alloc(&CG(arena), size + 64);
+	return (void*)(((uintptr_t)mem + 63L) & ~63L);
+#else
+	return zend_arena_alloc(&CG(arena), size);
+#endif
+}
+
+static void pf_lb_free_script(pf_lb_script *s, pf_lb_desc *descs, uint32_t n)
+{
+	if (descs) {
+		for (uint32_t i = 0; i < n; i++) {
+			free(descs[i].oas);
+		}
+		free(descs);
+	}
+	if (s) {
+		free(s->path);
+		free(s);
+	}
+}
+
+/* the head unserializer meets a lazy op_array: record its body (once per directory entry) and its op_array */
+static pf_lb_desc *pf_lb_head_desc(zend_persistent_script *script, zend_op_array *op_array)
+{
+	int k;
+	pf_lb_desc *d;
+	if (!pf_lzh.descs || !script->pf_body_dir || !op_array->opcodes) {
+		return NULL;
+	}
+	k = pf_dir_find(script->pf_body_dir, script->pf_body_dir_n, (size_t)op_array->opcodes);
+	if (k < 0 || (uint32_t)k >= pf_lzh.n) {
+		return NULL;
+	}
+	d = &pf_lzh.descs[k];
+	if (!d->s) {
+		d->s = pf_lzh.s;
+		d->k = (uint32_t)k;
+		d->lit = (uintptr_t)op_array->literals;
+		d->ops = (uintptr_t)op_array->opcodes;
+		d->lr = (uintptr_t)op_array->live_range;
+		d->tc = (uintptr_t)op_array->try_catch_array;
+		d->last = op_array->last;
+		d->last_literal = op_array->last_literal;
+		d->last_live_range = op_array->last_live_range;
+		d->last_try_catch = op_array->last_try_catch;
+	}
+	if (d->n_oa == d->cap_oa) {
+		uint32_t cap = d->cap_oa ? d->cap_oa * 2 : 2;
+		zend_op_array **oas = realloc(d->oas, sizeof(zend_op_array*) * cap);
+		if (!oas) {
+			zend_error_noreturn(E_ERROR, "pagefeather lazy bodies: out of memory recording a body");
+		}
+		d->oas = oas;
+		d->cap_oa = cap;
+	}
+	d->oas[d->n_oa++] = op_array;
+	return d;
+}
+
+static void pf_lb_stub_state(zend_op_array *op_array, pf_lb_desc *d)
+{
+	op_array->opcodes = pf_lb_stub;
+	op_array->last = PF_LB_STUB_LEN;
+	op_array->literals = NULL;
+	op_array->last_literal = 0;
+	op_array->live_range = NULL;
+	op_array->last_live_range = 0;
+	op_array->try_catch_array = NULL;
+	op_array->last_try_catch = 0;
+	op_array->reserved[pf_lb_slot] = d;
+}
+
+/* mirrors the literal and opcode loops of zend_file_cache_unserialize_op_array (re-check on every PHP bump) */
+static void pf_lb_unserialize_body(zend_op_array *op_array, zend_persistent_script *script, void *buf)
+{
+	if (op_array->literals) {
+		zval *p, *end;
+
+		UNSERIALIZE_PTR(op_array->literals);
+		p = op_array->literals;
+		end = p + op_array->last_literal;
+		while (p < end) {
+			zend_file_cache_unserialize_zval(p, script, buf);
+			p++;
+		}
+	}
+	{
+		zend_op *opline, *end;
+
+		UNSERIALIZE_PTR(op_array->opcodes);
+		opline = op_array->opcodes;
+		end = opline + op_array->last;
+		while (opline < end) {
+#if ZEND_USE_ABS_CONST_ADDR
+			if (opline->op1_type == IS_CONST) {
+				UNSERIALIZE_PTR(opline->op1.zv);
+			}
+			if (opline->op2_type == IS_CONST) {
+				UNSERIALIZE_PTR(opline->op2.zv);
+			}
+#else
+			if (opline->op1_type == IS_CONST) {
+				ZEND_PASS_TWO_UPDATE_CONSTANT(op_array, opline, opline->op1);
+			}
+			if (opline->op2_type == IS_CONST) {
+				ZEND_PASS_TWO_UPDATE_CONSTANT(op_array, opline, opline->op2);
+			}
+#endif
+#if ZEND_USE_ABS_JMP_ADDR
+			switch (opline->opcode) {
+				case ZEND_JMP:
+				case ZEND_FAST_CALL:
+					UNSERIALIZE_PTR(opline->op1.jmp_addr);
+					break;
+				case ZEND_JMPZ:
+				case ZEND_JMPNZ:
+				case ZEND_JMPZ_EX:
+				case ZEND_JMPNZ_EX:
+				case ZEND_JMP_SET:
+				case ZEND_COALESCE:
+				case ZEND_FE_RESET_R:
+				case ZEND_FE_RESET_RW:
+				case ZEND_ASSERT_CHECK:
+				case ZEND_JMP_NULL:
+				case ZEND_BIND_INIT_STATIC_OR_JMP:
+					UNSERIALIZE_PTR(opline->op2.jmp_addr);
+					break;
+				case ZEND_CATCH:
+					if (!(opline->extended_value & ZEND_LAST_CATCH)) {
+						UNSERIALIZE_PTR(opline->op2.jmp_addr);
+					}
+					break;
+				case ZEND_FE_FETCH_R:
+				case ZEND_FE_FETCH_RW:
+				case ZEND_SWITCH_LONG:
+				case ZEND_SWITCH_STRING:
+					/* relative extended_value don't have to be changed */
+					break;
+			}
+#endif
+			zend_deserialize_opcode_handler(opline);
+			opline++;
+		}
+	}
+	UNSERIALIZE_PTR(op_array->live_range);
+	UNSERIALIZE_PTR(op_array->try_catch_array);
+}
+
+/* unserialize one body: its span is at span (serialized offsets [span_off, span_off + span_len] map there), its own
+ * strings at strs; chunk..chunk + len is everything just read. Nothing is installed here. */
+static bool pf_lb_unserialize_into(pf_lb_desc *d, char *chunk, size_t len, char *span, char *strs)
+{
+	const pf_body_dir_entry *e = &d->s->dir[d->k];
+	zend_op_array tmp;
+	zend_persistent_script fake;
+	void *saved_mem = ZCG(mem);
+	bool ok;
+
+	memset(&tmp, 0, sizeof(tmp));
+	memset(&fake, 0, sizeof(fake));
+	tmp.literals = (zval*)d->lit;
+	tmp.last_literal = d->last_literal;
+	tmp.opcodes = (zend_op*)d->ops;
+	tmp.last = d->last;
+	tmp.live_range = (zend_live_range*)d->lr;
+	tmp.last_live_range = d->last_live_range;
+	tmp.try_catch_array = (zend_try_catch_element*)d->tc;
+	tmp.last_try_catch = d->last_try_catch;
+	fake.mem = d->s->head;
+	fake.size = d->s->full_size;
+	fake.corrupted = false;
+	pf_lz.chunk = chunk;
+	pf_lz.span = span;
+	pf_lz.head = d->s->head;
+	pf_lz.len = len;
+	pf_lz.lo = e->span_off;
+	pf_lz.hi = (size_t)e->span_off + e->span_len;
+	pf_lz.tail = d->s->tail;
+	pf_lz.bad = false;
+	ZCG(mem) = strs;
+	pf_lb_unserialize_body(&tmp, &fake, NULL);
+	ZCG(mem) = saved_mem;
+	ok = !pf_lz.bad;
+	pf_lz.chunk = NULL;
+	if (ok) {
+		d->literals = tmp.literals;
+		d->opcodes = tmp.opcodes;
+		d->live_range = tmp.live_range;
+		d->try_catch_array = tmp.try_catch_array;
+	}
+	return ok;
+}
+
+/* opcache.pagefeather_lazy_unit=script: read the script's whole body tail and body-string section, check and
+ * unserialize every body of it, and only when all of them succeed mark them loaded. A failure keeps nothing. */
+static zend_result pf_lb_load_script(pf_lb_script *s)
+{
+	size_t tail = s->full_size - s->tail, len = tail + s->bstr_len;
+	zend_hrtime_t t0 = zend_hrtime();
+	char *chunk = malloc(len ? len : 1);
+	bool ok = chunk != NULL;
+	uint32_t i, n = 0;
+
+	if (ok) {
+		zend_hrtime_t p0 = zend_hrtime(), p1, p2;
+		int fd = open(s->path, O_RDONLY | O_BINARY);
+		p1 = zend_hrtime();
+		ok = fd >= 0
+			&& pf_lb_pread(fd, chunk, tail, sizeof(zend_file_cache_metainfo) + s->tail)
+			&& pf_lb_pread(fd, chunk + tail, s->bstr_len, s->bstr_base);
+		p2 = zend_hrtime();
+		if (fd >= 0) {
+			close(fd);
+		}
+		pf_lb_open_ns += (uint64_t)((p1 - p0) + (zend_hrtime() - p2)); /* pagefeather lazy bodies (#582 M2b, the load phases) */
+		pf_lb_read_ns += (uint64_t)(p2 - p1);
+	}
+	for (i = 0; ok && i < s->n; i++) {
+		pf_lb_desc *d = &s->descs[i];
+		const pf_body_dir_entry *e;
+		uint32_t a;
+		if (!d->s || d->loaded) {
+			continue;
+		}
+		e = &s->dir[d->k];
+		if ((size_t)e->span_off < s->tail || (size_t)e->span_off + e->span_len > s->full_size
+		 || (size_t)e->str_off + e->str_len > s->bstr_len) {
+			ok = false;
+			break;
+		}
+		{
+			zend_hrtime_t p0 = zend_hrtime(), p1;
+			a = zend_adler32(ADLER32_INIT, (unsigned char*)chunk + (e->span_off - s->tail), e->span_len);
+			a = zend_adler32(a, (unsigned char*)chunk + tail + e->str_off, e->str_len);
+			p1 = zend_hrtime();
+			pf_lb_check_ns += (uint64_t)(p1 - p0);
+			ok = a == e->adler && pf_lb_unserialize_into(d, chunk, len, chunk + (e->span_off - s->tail), chunk + tail + e->str_off);
+			pf_lb_unser_ns += (uint64_t)(zend_hrtime() - p1);
+		}
+		n += ok ? 1 : 0;
+	}
+	pf_lb_body_load_ns += (uint64_t)(zend_hrtime() - t0);
+	if (!ok) {
+		free(chunk); /* the bodies unserialized before the failure are not marked loaded: nothing is kept */
+		pf_lb_body_fail++;
+		return FAILURE;
+	}
+	for (i = 0; i < s->n; i++) {
+		if (s->descs[i].s && !s->descs[i].loaded) {
+			s->descs[i].loaded = true;
+		}
+	}
+	s->chunk = chunk;
+	pf_lb_script_loads++;
+	pf_lb_body_loads += n;
+	pf_lb_body_bytes_loaded += len;
+	pf_lb_body_bytes_resident += len;
+	return SUCCESS;
+}
+
+/* pagefeather lazy bodies (#582 M2b stage 5): opcache.pagefeather_lazy_unit=hot. One open and one read of the
+ * script's tail and body strings; the hot bodies and the called one (want) are copied out into their own chunks,
+ * checked and unserialized one by one; the read buffer is freed. The cold bodies stay lazy per body. A body that
+ * fails its check is not kept (the called one makes this load fail; a hot one just stays lazy). */
+static zend_result pf_lb_load_hot(pf_lb_desc *want)
+{
+	pf_lb_script *s = want->s;
+	size_t tail = s->full_size - s->tail, len = tail + s->bstr_len;
+	zend_hrtime_t t0 = zend_hrtime();
+	char *buf = malloc(len ? len : 1);
+	bool ok = buf != NULL;
+	uint32_t i;
+
+	if (ok) {
+		zend_hrtime_t p0 = zend_hrtime(), p1, p2;
+		int fd = open(s->path, O_RDONLY | O_BINARY);
+		p1 = zend_hrtime();
+		ok = fd >= 0
+			&& pf_lb_pread(fd, buf, tail, sizeof(zend_file_cache_metainfo) + s->tail)
+			&& pf_lb_pread(fd, buf + tail, s->bstr_len, s->bstr_base);
+		p2 = zend_hrtime();
+		if (fd >= 0) {
+			close(fd);
+		}
+		pf_lb_open_ns += (uint64_t)((p1 - p0) + (zend_hrtime() - p2));
+		pf_lb_read_ns += (uint64_t)(p2 - p1);
+	}
+	if (!ok) {
+		free(buf);
+		pf_lb_body_fail++;
+		pf_lb_body_load_ns += (uint64_t)(zend_hrtime() - t0);
+		return FAILURE; /* nothing read: the next call tries the hot read again */
+	}
+	s->hot_done = true;
+	pf_lb_hot_loads++;
+	pf_lb_hot_read_bytes += len;
+	for (i = 0; i < s->n; i++) {
+		pf_lb_desc *x = &s->descs[i];
+		const pf_body_dir_entry *e;
+		size_t size;
+		char *c;
+		bool good;
+		if (!x->s || x->loaded || !(x->hot || x == want)) {
+			continue;
+		}
+		e = &s->dir[x->k];
+		if ((size_t)e->span_off < s->tail || (size_t)e->span_off + e->span_len > s->full_size
+		 || (size_t)e->str_off + e->str_len > s->bstr_len) {
+			pf_lb_body_fail++;
+			continue;
+		}
+		size = (size_t)e->span_len + e->str_len;
+		c = malloc(size ? size : 1);
+		if (!c) {
+			pf_lb_body_fail++;
+			continue;
+		}
+		memcpy(c, buf + (e->span_off - s->tail), e->span_len);
+		memcpy(c + e->span_len, buf + tail + e->str_off, e->str_len);
+		{
+			zend_hrtime_t p0 = zend_hrtime(), p1;
+			good = zend_adler32(ADLER32_INIT, (unsigned char*)c, size) == e->adler;
+			p1 = zend_hrtime();
+			pf_lb_check_ns += (uint64_t)(p1 - p0);
+			good = good && pf_lb_unserialize_into(x, c, size, c, c + e->span_len);
+			pf_lb_unser_ns += (uint64_t)(zend_hrtime() - p1);
+		}
+		if (!good) {
+			free(c);
+			pf_lb_body_fail++;
+			continue;
+		}
+		x->chunk = c;
+		x->loaded = true;
+		pf_lb_body_loads++;
+		pf_lb_hot_bodies += x != want;
+		pf_lb_body_bytes_loaded += size;
+		pf_lb_body_bytes_resident += size;
+	}
+	free(buf);
+	pf_lb_body_load_ns += (uint64_t)(zend_hrtime() - t0);
+	return want->loaded ? SUCCESS : FAILURE;
+}
+
+/* pagefeather lazy bodies (#582 M2b stage 5): <bin>.hot. "PFHOT1\0\0", the .bin's pf_head_checksum, the directory
+ * size, a count, then that many directory indices (all uint32, host order: one engine writes and reads them). */
+#define PF_HOT_MAGIC "PFHOT1\0\0"
+static void pf_lb_read_hot(pf_lb_script *s, uint32_t head_checksum)
+{
+	char *p = malloc(strlen(s->path) + 5);
+	char magic[8];
+	uint32_t h[3], k;
+	int fd;
+	if (!p) {
+		return;
+	}
+	strcpy(p, s->path);
+	strcat(p, ".hot");
+	fd = open(p, O_RDONLY | O_BINARY);
+	free(p);
+	if (fd < 0) {
+		return;
+	}
+	if (pf_lb_pread(fd, magic, 8, 0) && memcmp(magic, PF_HOT_MAGIC, 8) == 0 && pf_lb_pread(fd, (char*)h, sizeof(h), 8)
+	 && h[0] == head_checksum && h[1] == s->n && h[2] <= s->n) {
+		for (uint32_t i = 0; i < h[2]; i++) {
+			if (!pf_lb_pread(fd, (char*)&k, sizeof(k), 8 + sizeof(h) + (size_t)i * sizeof(k))) {
+				break;
+			}
+			if (k < s->n && s->descs[k].s && !s->descs[k].hot) {
+				s->descs[k].hot = true;
+				s->n_hot++;
+			}
+		}
+		if (s->n_hot) {
+			pf_lb_hot_scripts++;
+		}
+	}
+	close(fd);
+}
+
+/* opcache.pagefeather_profile=1: this request's called bodies, as .bin path -> set of directory indices; flushed into
+ * the .hot files (merged with what they hold) after each request. Priming only: an observer runs on every call. */
+static HashTable pf_prof_files; /* path -> pf_prof_set* */
+static bool pf_prof_on = false;
+typedef struct { uint32_t n; uint8_t *bits; bool dirty; } pf_prof_set;
+
+static void pf_lb_prof_mark(zend_string *path, uint32_t n, uint32_t k)
+{
+	zval *v = zend_hash_find(&pf_prof_files, path);
+	pf_prof_set *set;
+	if (!v) {
+		zval z;
+		set = calloc(1, sizeof(*set));
+		if (!set || !(set->bits = calloc((n + 7) / 8 + 1, 1))) {
+			free(set);
+			return;
+		}
+		set->n = n;
+		ZVAL_PTR(&z, set);
+		zend_hash_add_new(&pf_prof_files, path, &z);
+	} else {
+		set = Z_PTR_P(v);
+	}
+	if (k < set->n && !(set->bits[k / 8] & (1u << (k % 8)))) {
+		set->bits[k / 8] |= (uint8_t)(1u << (k % 8));
+		set->dirty = true;
+	}
+}
+
+/* the body d just loaded at a call (or a look that needs it): in a profiling run, it is hot */
+static void pf_lb_prof_note(const pf_lb_desc *d)
+{
+	zend_string *path;
+	if (!pf_prof_on || !d->s) {
+		return;
+	}
+	path = zend_string_init(d->s->path, strlen(d->s->path), 1);
+	pf_lb_prof_mark(path, d->s->n, d->k);
+	zend_string_release(path);
+}
+
+void pf_lb_profile_startup(void)
+{
+	if (ZCG(accel_directives).pf_profile && !pf_prof_on) {
+		zend_hash_init(&pf_prof_files, 256, NULL, NULL, 1);
+		pf_prof_on = true; /* no observer: one would change the system id (zend_system_id.c), and the .hot would sit
+							* beside files the shipped engine never loads; the loads themselves are the profile */
+	}
+}
+
+/* merge one script's set into <bin>.hot; the head checksum comes from the .bin itself */
+static void pf_lb_prof_write(const char *bin, pf_prof_set *set)
+{
+	zend_file_cache_metainfo info;
+	char *p = malloc(strlen(bin) + 9);
+	uint32_t h[3], k, cnt = 0;
+	char magic[8];
+	int fd;
+	if (!p) {
+		return;
+	}
+	fd = open(bin, O_RDONLY | O_BINARY);
+	if (fd < 0 || !pf_lb_pread(fd, (char*)&info, sizeof(info), 0) || memcmp(info.magic, "OPCACHE", 8) != 0) {
+		if (fd >= 0) {
+			close(fd);
+		}
+		free(p);
+		return;
+	}
+	close(fd);
+	strcpy(p, bin);
+	strcat(p, ".hot");
+	fd = open(p, O_RDONLY | O_BINARY); /* the indices already there stay hot */
+	if (fd >= 0) {
+		if (pf_lb_pread(fd, magic, 8, 0) && memcmp(magic, PF_HOT_MAGIC, 8) == 0 && pf_lb_pread(fd, (char*)h, sizeof(h), 8)
+		 && h[0] == info.pf_head_checksum && h[1] == set->n && h[2] <= set->n) {
+			for (uint32_t i = 0; i < h[2] && pf_lb_pread(fd, (char*)&k, sizeof(k), 8 + sizeof(h) + (size_t)i * sizeof(k)); i++) {
+				if (k < set->n) {
+					set->bits[k / 8] |= (uint8_t)(1u << (k % 8));
+				}
+			}
+		}
+		close(fd);
+	}
+	for (k = 0; k < set->n; k++) {
+		cnt += (set->bits[k / 8] >> (k % 8)) & 1;
+	}
+	strcat(p, ".tmp");
+	fd = open(p, O_WRONLY | O_CREAT | O_TRUNC | O_BINARY, S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH);
+	if (fd >= 0) {
+		bool ok;
+		h[0] = info.pf_head_checksum;
+		h[1] = set->n;
+		h[2] = cnt;
+		ok = write(fd, PF_HOT_MAGIC, 8) == 8 && write(fd, h, sizeof(h)) == (ssize_t)sizeof(h);
+		for (k = 0; ok && k < set->n; k++) {
+			if ((set->bits[k / 8] >> (k % 8)) & 1) {
+				ok = write(fd, &k, sizeof(k)) == (ssize_t)sizeof(k);
+			}
+		}
+		close(fd);
+		if (ok) {
+			char *dst = strdup(p);
+			if (dst) {
+				dst[strlen(dst) - 4] = '\0';
+				ok = rename(p, dst) == 0;
+				free(dst);
+			}
+		}
+		if (ok) {
+			pf_lb_prof_writes++;
+		} else {
+			unlink(p);
+		}
+	}
+	free(p);
+}
+
+void pf_lb_profile_flush(void)
+{
+	zend_string *path;
+	zval *v;
+	if (!pf_prof_on) {
+		return;
+	}
