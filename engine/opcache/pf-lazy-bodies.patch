+uint32_t zend_accel_script_persist_calc(zend_persistent_script *new_persistent_script, int for_shm)
+{
+	uint32_t size;
+	if (!for_shm) {
+		return pf_lb_script_persist_calc_once(new_persistent_script, for_shm);
+	}
+	if (pf_lb_shared) {
+		zend_hash_destroy(pf_lb_shared);
+		FREE_HASHTABLE(pf_lb_shared);
+		pf_lb_shared = NULL;
+	}
+	zend_hash_init(&pf_lb_owner, 256, NULL, NULL, 0);
+	pf_lb_pass = 1;
+	pf_lb_script_persist_calc_once(new_persistent_script, for_shm);
+	zend_hash_destroy(&pf_lb_owner);
+	zend_shared_alloc_clear_xlat_table();
+	pf_lb_pass = 2;
+	size = pf_lb_script_persist_calc_once(new_persistent_script, for_shm);
+	pf_lb_pass = 0;
+	return size;
+}
