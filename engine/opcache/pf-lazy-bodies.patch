+/* read, check and unserialize one body (or, by opcache.pagefeather_lazy_unit, its whole script); on success it is
+ * resident, on failure nothing is kept */
+static zend_result pf_lb_load(pf_lb_desc *d)
+{
+	const pf_body_dir_entry *e = &d->s->dir[d->k];
+	size_t span = e->span_len, len = span + e->str_len;
+	zend_hrtime_t t0;
+	char *chunk;
+	bool ok;
+
+	if (ZCG(accel_directives).pf_lazy_unit == 1) {
+		return pf_lb_load_script(d->s);
+	}
+	if (ZCG(accel_directives).pf_lazy_unit == 2 && d->s->n_hot && !d->s->hot_done) {
+		return pf_lb_load_hot(d); /* pagefeather lazy bodies (#582 M2b stage 5) */
+	}
+	t0 = zend_hrtime();
+	chunk = malloc(len ? len : 1);
+	ok = chunk != NULL;
+	if (ok) {
+		zend_hrtime_t p0 = zend_hrtime(), p1, p2;
+		int fd = open(d->s->path, O_RDONLY | O_BINARY);
+		p1 = zend_hrtime();
+		ok = fd >= 0
+			&& pf_lb_pread(fd, chunk, span, sizeof(zend_file_cache_metainfo) + (size_t)e->span_off)
+			&& pf_lb_pread(fd, chunk + span, e->str_len, d->s->bstr_base + e->str_off);
+		p2 = zend_hrtime();
+		if (fd >= 0) {
+			close(fd);
+		}
+		pf_lb_open_ns += (uint64_t)((p1 - p0) + (zend_hrtime() - p2)); /* pagefeather lazy bodies (#582 M2b, the load phases) */
+		pf_lb_read_ns += (uint64_t)(p2 - p1);
+	}
+	if (ok) {
+		zend_hrtime_t p0 = zend_hrtime(), p1;
+		ok = zend_adler32(ADLER32_INIT, (unsigned char*)chunk, len) == e->adler;
+		p1 = zend_hrtime();
+		pf_lb_check_ns += (uint64_t)(p1 - p0);
+		ok = ok && pf_lb_unserialize_into(d, chunk, len, chunk, chunk + span);
+		pf_lb_unser_ns += (uint64_t)(zend_hrtime() - p1);
+	}
+	pf_lb_body_load_ns += (uint64_t)(zend_hrtime() - t0);
+	if (!ok) {
+		free(chunk);
+		pf_lb_body_fail++;
+		return FAILURE;
+	}
+	d->chunk = chunk;
+	d->loaded = true;
+	pf_lb_prof_note(d); /* pagefeather lazy bodies (#582 M2b stage 5) */
+	pf_lb_body_loads++;
+	pf_lb_body_bytes_loaded += len;
+	pf_lb_body_bytes_resident += len;
+	return SUCCESS;
+}
