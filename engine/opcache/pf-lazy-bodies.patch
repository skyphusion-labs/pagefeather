+			pf_lb_split++;
+			pf_lb_body_bytes += script->pf_body_size;
+		}
+	} else {
+		ZCG(mem) = pf_lb_body_mem;
+	}
+	pf_lb_body_mem = NULL;
+	pf_lb_active = false;
